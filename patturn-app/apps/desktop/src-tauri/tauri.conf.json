{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patturn",
  "version": "0.2.0",
  "identifier": "ir.patturn.studio",
  "build": {
    "beforeDevCommand": "npm run dev -w @patturn/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @patturn/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patturn — کارگاه سفال پارامتریک",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Farsi", "English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "sql": {
      "defaultDbName": "patturn"
    }
  }
}
